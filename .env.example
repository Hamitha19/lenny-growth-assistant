# Database connection string (replace with your own)

DATABASE_URL=

# Local Ollama configuration

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_URL=http://localhost:11434/api/embed
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b

# Generation provider: ollama (default) or openai
MODEL_PROVIDER=ollama

# Optional cloud generation. Leave the key blank for the local demo.
# Transcript embeddings still use Ollama in either provider mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
